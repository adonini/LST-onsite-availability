# Copy to .env.prod on the server. Never commit .env.prod or real secrets.
APP_ENV_FILE=.env.prod
PROD_DB_DIR=/home/lst1/lst-onsite-availability/db_data
PROD_EVENTS_JSON=/home/www/git/lst.iac.es/website/public/travel/lst1_events.json
# Keep 127.0.0.1 if the HTTPS proxy runs on this host. Otherwise use a private IP
# reachable only by the trusted proxy and restrict port 8088 with a firewall.
PROD_BIND_IP=127.0.0.1
PROD_PORT=8088

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=calendar.lst.iac.es,calendar.lst1.iac.es
DJANGO_CSRF_TRUSTED_ORIGINS=https://calendar.lst.iac.es,https://calendar.lst1.iac.es
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
# Only enable when the trusted HTTPS proxy overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=true

DEFAULT_FROM_EMAIL=lst-onsite@cta-observatory.org
